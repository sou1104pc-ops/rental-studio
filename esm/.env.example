# ─── Discord ───────────────────────────────────────────────
# Discord Developer Portal で作成したボットのトークン
DISCORD_TOKEN=

# コマンドを即時反映させたいサーバー(ギルド)ID。テスト中は設定推奨。
# 本番でグローバル公開する場合は空のままでOK（反映に最大1時間）。
DISCORD_GUILD_ID=

# このチャンネルへの投稿を自動で日報メモとして記録する（チャンネルID）
REPORT_CHANNEL_ID=

# 売上サマリーを自動投稿するチャンネルID
SUMMARY_CHANNEL_ID=

# 自動サマリーの投稿時刻（JST, HH:MM）。SUMMARY_CHANNEL_ID 設定時のみ動作。
SUMMARY_TIME=09:00

# ─── Claude API ────────────────────────────────────────────
# https://console.anthropic.com で発行したAPIキー
ANTHROPIC_API_KEY=

# 使用モデル。既定は最新の Claude Opus 4.8。
# コストを抑えたい場合は claude-haiku-4-5 などに変更可。
CLAUDE_MODEL=claude-opus-4-8

# ─── その他 ────────────────────────────────────────────────
COMPANY_NAME=株式会社ESM
TIMEZONE=Asia/Tokyo
# SQLite の保存先（省略時は esm/esm.db）
# ESM_DB_PATH=
